# Copy this file to .env.local for local development
# Set these in Vercel project settings for production.

# Provider selector:
#   openrouter | nanogpt | opencode_go | clinepass | refuseless | openai | groq | together | fireworks | xai | kie | custom
# Default stays openrouter. Selecting any kie/... model in the UI still routes to Kie
# even when AI_PROVIDER=openrouter (per-model dual routing). KIE_API_KEY also powers
# in-app sermon Images/Video via /api/kie-media.
AI_PROVIDER=openrouter

# Optional override if you run any OpenAI-compatible gateway.
# Example: https://api.openrouter.ai/api/v1
AI_BASE_URL=

# Optional Kie host override (default https://api.kie.ai)
KIE_BASE_URL=

# API keys (set AI_API_KEY or provider-specific key)
AI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
XAI_API_KEY=
KIE_API_KEY=

# -----------------------------------------------------------------------------
# VERCEL API KEYS — OpenCode Go · ClinePass · Refuseless (paste YOUR keys in Vercel)
# -----------------------------------------------------------------------------
# Dashboard: Project → Settings → Environment Variables → Add New
#   • Name  = variable below (exact spelling)
#   • Value = your secret key from that provider’s console
#   • Environments = Production (and Preview/Development if you use them)
# Then Redeploy. Keys never go in the browser or this repo — only on Vercel.
#
# OpenCode Go — https://opencode.ai (Go subscription / console API key)
OPENCODE_GO_API_KEY=
# Optional alias if your key is stored under the legacy name:
OPENCODE_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_DEFAULT_MODEL=
#
# ClinePass — https://app.cline.bot → Settings → API Keys
CLINEPASS_API_KEY=
# Optional alias (same Cline API key works for Pay-as-you-go and ClinePass models):
CLINE_API_KEY=
CLINEPASS_BASE_URL=https://api.cline.bot/api/v1
CLINEPASS_DEFAULT_MODEL=
#
# Refuseless — https://refuseless.com console (keys often start with abl_)
REFUSELESS_API_KEY=
REFUSELESS_BASE_URL=https://api.refuseless.com/v1
REFUSELESS_DEFAULT_MODEL=

NANOGPT_API_KEY=
# Optional NanoGPT overrides; use exact IDs from its catalog.
NANOGPT_BASE_URL=https://nano-gpt.com/api/v1
NANOGPT_DEFAULT_MODEL=

# OrcaRouter Local / RunPod llama.cpp (UI: "OrcaRouter Local" — not AI_PROVIDER)
# Server-only — never expose LOCAL_LLM_API_KEY to the browser.
LOCAL_LLM_BASE_URL=https://91olopadheefpl-8080.proxy.runpod.net/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=orcarouter_Qwen3.8-27B-Uncensored-Q6_K_L.gguf
LOCAL_LLM_MAX_CONTEXT=65536
LOCAL_LLM_TEMPERATURE=0.7
LOCAL_LLM_TOP_P=0.8
LOCAL_LLM_TOP_K=20
LOCAL_LLM_MIN_P=0
LOCAL_LLM_REPEAT_PENALTY=1.08
LOCAL_LLM_SERMON_MAX_TOKENS=4800
LOCAL_LLM_DEFAULT_MAX_TOKENS=8192
# Qwen3 OrcaRouter: chat_template_kwargs enable_thinking/preserve_thinking false, /no_think (default on).
LOCAL_LLM_DISABLE_THINKING=true
# RunPod llama-server (recommended): --reasoning-budget 0 and/or
#   --chat-template-kwargs '{"enable_thinking":false}'
# Legacy BONSAI_* names still read as fallback if LOCAL_LLM_* unset.

# Optional defaults
DEFAULT_TEXT_MODEL=google/gemini-3-flash-preview
AI_INCLUDE_STREAM_USAGE=true
AI_HTTP_REFERER=http://localhost:3000
AI_APP_NAME=YAH Forge Direct

# Optional JSON map to alias current UI model labels to provider model IDs.
# MODEL_ALIASES_JSON={"Gemini-3.1-Pro":"google/gemini-2.5-pro","Claude-Sonnet-4.5":"anthropic/claude-sonnet-4"}
MODEL_ALIASES_JSON=

# Optional JSON for additional headers required by your provider.
# AI_EXTRA_HEADERS_JSON={"X-API-Version":"2024-10-01"}
AI_EXTRA_HEADERS_JSON=

# Optional Reddit OAuth (helps when Reddit blocks datacenter IPs on /api/reddit)
# Create a "script" or "web app" at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=web:yah-forge-direct:v1.0.0 (by /u/your_reddit_username)
